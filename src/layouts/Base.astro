---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Matomo from '../components/Matomo.astro';
import { BUILD_ID } from '../data/pwa-stamp';
const props = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <Head title={props.title} fullTitle={props.fullTitle} desc={props.desc} robots={props.robots} ogType={props.ogType} cspExtra={props.cspExtra} image={props.image} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Matomo />
  <!-- P17a: classic (non-module) script so document.currentScript resolves the SW
       URL relative to its own shipped path - base-aware on apex and subpath. -->
  <script is:inline src={`/pwa-install.js?v=${BUILD_ID}`}></script>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
