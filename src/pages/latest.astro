---
import Base from '../layouts/Base.astro';
import { POSTS, SITE, TOTALS, fmtDate } from '../data/site';
import { coverFor } from '../data/covers';
/* T_1C669C70: CollectionPage + ItemList + BreadcrumbList. /latest/ is
   indexable (wiring assumes it stays so). ItemList follows the rendered
   POSTS order verbatim - never re-sorted, so markup mirrors the DOM. */
const latestCollectionLD = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Latest - all ${TOTALS.posts} guides`,
  description: 'Every AndroidScroll guide on one page.',
  url: SITE.url + '/latest/',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url + '/' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: POSTS.length,
    itemListElement: POSTS.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: SITE.url + p.url,
      name: p.title,
    })),
  },
};
const latestBreadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Latest' },
  ],
};
---
<Base title={`Latest - all ${TOTALS.posts} guides`} desc="Every AndroidScroll guide, newest first.">
  <script type="application/ld+json" set:html={JSON.stringify(latestCollectionLD)} />
  <script type="application/ld+json" set:html={JSON.stringify(latestBreadcrumbLD)} />
  <div class="wrap" style="padding-bottom:56px">
    <nav class="crumb" aria-label="Breadcrumb" style="padding-top:26px"><a href="/">Home</a> <span>›</span> <span>Latest</span></nav>
    <header class="cat-hero"><h1>Latest</h1><p class="intro">All {TOTALS.posts} guides, newest first - the whole library fits on one page today. That's the honest state of the shelf.</p></header>
    <div class="cat-list">
      {POSTS.map(p => (
        <article>
          <a href={p.url} tabindex="-1" aria-hidden="true"><img class="cov-thumb cat-thumb" src={coverFor(p.slug).thumb} width="480" height="253" alt="" loading="lazy" decoding="async" /></a>
          <div>
            <h3><a href={p.url}>{p.title}</a></h3>
            <p class="x">{p.excerpt}</p>
            <div class="byline" style="margin-top:8px"><span>{fmtDate(p.date)}</span><span>{p.root_name}</span>{p.read_min && <span><b>{p.read_min} min</b></span>}<span>{p.comments} comments</span></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
