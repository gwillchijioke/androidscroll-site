---
import StaticPage from '../layouts/StaticPage.astro';
import { SITE, TOTALS } from '../data/site';
import { breadcrumbLD, pageLD } from '../lib/schema';
/* T_1C669C70: AboutPage + BreadcrumbList + trusted Person #author.
   sameAs omitted until the King confirms handles (never brand accounts). */
const aboutLD = [
  pageLD('AboutPage', 'About AndroidScroll', '/about/', 'A small desk with one rule: guide the phone in your hand, not the spec sheet.'),
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': SITE.url + '/about/#author',
    name: 'G-will Chijioke',
    url: SITE.url + '/about/#author',
    jobTitle: 'Founder',
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url + '/' },
  },
  breadcrumbLD([{ name: 'Home', href: '/' }, { name: 'About AndroidScroll' }]),
];
---
<StaticPage title="About AndroidScroll" desc="A small desk with one rule: guide the phone in your hand, not the spec sheet." kicker="The paper" hideStub jsonld={aboutLD}>
  <p style='font-size:17px;line-height:1.7;max-width:62ch'>AndroidScroll started in 2019 with one post about water damage and a stubborn belief: most Android advice is written for reviewers, not for people holding the phone. {TOTALS.posts} guides later, the rule hasn't changed - practical, honest, tested on mid-range hardware.</p>
<h2 id='author' style='font-family:var(--display);letter-spacing:-.03em;font-size:24px;margin:30px 0 8px'>Who writes this</h2><div class='author-box' style='margin:0'><img class='t-mono-av' src='/img/author.png' alt='' aria-hidden='true' width='48' height='48' loading='lazy' decoding='async'><div><p class='a-name'>G-will Chijioke</p><p>Founder. Android &amp; security writing since 2019. Corrections, tips and privacy scoops: <a href='mailto:contact@androidscroll.com'>contact@androidscroll.com</a>.</p></div></div>
</StaticPage>
