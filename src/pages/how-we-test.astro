---
import StaticPage from '../layouts/StaticPage.astro';
import { TOTALS } from '../data/site';
import { breadcrumbLD, pageLD } from '../lib/schema';
/* T_1C669C70: WebPage + BreadcrumbList. Deliberately NOT HowTo - the page
   states principles, not a step sequence on the page itself. */
const ld = [
  pageLD('WebPage', 'How we test', '/how-we-test/', 'The public rubric behind every claim on this site.'),
  breadcrumbLD([{ name: 'Home', href: '/' }, { name: 'How we test' }]),
];
---
<StaticPage title="How we test" desc="The public rubric behind every claim on this site." kicker="Methodology" hideStub jsonld={ld}>
  <div class='kicker-h'>The process</div><p style='max-width:60ch'>Every verdict on this site passes the same five checks. A guide that cannot pass them does not ship.</p><ol class='fix-list' style='max-width:60ch'><li>Bought at retail: no review units, no loans, no favors.</li><li>Used daily for two weeks before any verdict is written.</li><li>Checked on everyday mid-range phones, with steps confirmed on my Tecno Spark 40.</li><li>Every claim names its source or its screen; guesses are cut.</li><li>Re-tested when Android changes, and the page carries the date it was last checked.</li></ol><p style='max-width:60ch;margin-top:18px'>Found a step that fails on your phone? <a href='/contact/'>Tell the desk</a>. Corrections ship the same week.</p>
</StaticPage>
