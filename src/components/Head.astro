---
// Head - meta/OG per page, inline design tokens for flash-free theme.
import { SITE } from '../data/site';
import { COMMENTS_API, PUSH_API } from '../data/endpoints';
import { THEME_COLORS } from '../data/theme-colors';
import { BUILD_ID } from '../data/pwa-stamp'; // generated by scripts/stamp-pwa.mjs (prebuild)
const props = Astro.props;
const canonical = SITE.url + Astro.url.pathname;
const title = props.fullTitle ? props.fullTitle : (props.title ? `${props.title} - ${SITE.name}` : `${SITE.name} - ${props.desc || SITE.tagline}`);
/* AUDIT-02 A1 (v0.6.36): optional per-page CSP extension. Only mod.astro passes
   it today (frame-ancestors 'none'); every other page renders the CSP byte-for-
   byte as before. Declared in a const so the two metas below stay identical. */
/* T_76AD7A34: Matomo tracker host joins script-src (matomo.js) + connect-src
   (matomo.php hits). Matomo-only - zero Cloudflare/custom beacons. */
const MATOMO = 'https://analytics.androidscroll.com';
const CSP = `default-src 'self'; script-src 'self' 'unsafe-inline' ${MATOMO}; style-src 'self' 'unsafe-inline'; img-src 'self' data: ${COMMENTS_API}; font-src 'self' data:; connect-src 'self' ${COMMENTS_API} ${PUSH_API} ${MATOMO}; frame-src youtube.com *.youtube.com www.youtube-nocookie.com youtu.be vimeo.com player.vimeo.com tiktok.com *.tiktok.com open.spotify.com *.apple.com embed.music.apple.com audiomack.com platform.twitter.com; object-src 'none'; base-uri 'self'${props.cspExtra ? `; ${props.cspExtra}` : ''}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- AUDIT-01 M3: baseline CSP for staging (meta cannot set frame-ancestors;
     apex host headers remain primary). Post-M5: no gravatar. v0.6.33 P17c2: adds
     the SAME-origin comments Worker to img-src for proxied avatars - still no
     third-party image host anywhere. AUDIT-02 A1 (v0.6.36): pages can extend the
     directive set via the cspExtra prop (mod.astro appends frame-ancestors 'none'
     - meta CSP CAN carry frame-ancestors when a page opts in; audit's host-header
     guidance stays primary for the general case). -->
<meta http-equiv="Content-Security-Policy" content={CSP} />
<!-- AUDIT-1 NICE-TO-HAVE (v0.6.60): no camera/mic/geo anywhere on the site,
     and cross-origin referrers buy nothing - say so explicitly. -->
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />
<title set:html={title}></title>
<meta name="description" content={props.desc || SITE.tagline} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={props.title || SITE.name} />
<meta property="og:description" content={props.desc || SITE.tagline} />
<meta property="og:type" content={props.ogType || 'website'} />
<meta property="og:url" content={canonical} />
<!-- SEO-1 (v0.6.69): shares were naked text. Brand OG card (1200x630 PNG -
     scrapers reject SVG, so articles share this card until per-article
     rasters exist); image prop lets any page override. Absolute apex URL
     per house canonical policy. -->
<meta property="og:image" content={SITE.url + (props.image || '/img/og-cover.png')} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={props.title ? `${props.title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={SITE.url + (props.image || '/img/og-cover.png')} />
<!-- v2.0 hybrid (meta2 audit, see /tmp/meta2-freebuff/REPORT.md): three metas at
     boot. The two media-pair metas serve no-JS/OS-dark sessions (v1.3's one known
     regression); any JS deletes them FIRST, so WHATWG first-match never sees them -
     a manual theme choice can never be shadowed. tc-base stays the single dynamic
     meta for all JS sessions (toggle, pageshow, visibilitychange). -->
<meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLORS.light} id="tc-base" data-light={THEME_COLORS.light} data-dark={THEME_COLORS.dark} />
<meta name="mobile-web-app-capable" content="yes" />
<!-- P17a: ?v=BUILD_ID busts install metadata with each release (root-absolute
     by house pattern - scripts/relativize.mjs makes it base-aware per page depth
     in dist, so it resolves right on apex '/' AND staging '/androidscroll-site/'). -->
<link rel="manifest" href={`/manifest.webmanifest?v=${BUILD_ID}`} />
{props.robots && <meta name="robots" content={props.robots} />}
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL('rss.xml', canonical).href} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/favicon-180.png" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/archivo-var-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/manrope-var-latin.woff2" />
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('as-theme') || 'system';
      localStorage.setItem('as-theme', t);
      var mq = matchMedia('(prefers-color-scheme: dark)');
      var apply = function () {
        var eff = t === 'system' ? (mq.matches ? 'dark' : 'light') : t;
        document.documentElement.setAttribute('data-theme', eff);
        document.documentElement.setAttribute('data-theme-pref', t);
        /* v1.3: single meta = always the first match. Plain content setAttribute
           repaints per spec (re-run rule) - no remove+re-insert needed. */
      var tc = document.getElementById('tc-base');
      /* v2.0 hybrid: drop the no-JS media-pair metas before touching tc-base so
         the dynamic meta is always the first (and only) match for JS sessions. */
      document.querySelectorAll('meta[name="theme-color"][media]').forEach(function (m) { m.remove(); });
      if (tc) {
        tc.setAttribute('content', eff === 'dark' ? tc.dataset.dark : tc.dataset.light);
      }
      };
      apply();
      if (t === 'system' && mq.addEventListener) mq.addEventListener('change', apply);
      document.documentElement.classList.add('js');
    } catch (e) {}
  })();
</script>
